<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title  %></title>
  <link rel="stylesheet" href="/css/login.css" />
</head>
<body>
  
<%- include('../partials/messages') %>
<main class="login-page">
  <!-- Left Side -->
  <section class="login-info">
    <div class="brand">
      <div class="brand-logo">S</div>
      <span>SAP</span>
    </div>

    <div class="info-content">
      <span class="badge">WELCOME BACK</span>

      <h1>
        Welcome back to
        <span>SAP</span>
      </h1>

      <p>
        Sign in to access your dashboard, manage your account and continue where
        you left off.
      </p>

      <div class="features">
        <div class="feature">
          <div class="feature-icon">✓</div>
          <div>
            <strong>Secure Login</strong>
            <small>Your data is protected</small>
          </div>
        </div>

        <div class="feature">
          <div class="feature-icon">⚡</div>
          <div>
            <strong>Fast & Reliable</strong>
            <small>Quick access to your account</small>
          </div>
        </div>

        <div class="feature">
          <div class="feature-icon">🛡</div>
          <div>
            <strong>Privacy First</strong>
            <small>Your privacy matters to us</small>
          </div>
        </div>
      </div>
    </div>

    <div class="copyright">© 2026 YourApp. All rights reserved.</div>
  </section>

  <!-- Right Side -->
  <section class="login-section">
    <div class="login-card">
      <div class="mobile-brand">
        <div class="brand-logo">s</div>
        <span>SAP</span>
      </div>

      <div class="login-header">
        <h2>Sign in</h2>
        <p>Enter your details to access your account.</p>
      </div>

      <form action="/login" method="POST" class="login-form">
        <!-- Email -->
        <div class="form-group">
          <label for="email">Email Address</label>

          <div class="input-box">
            <span class="input-icon">✉</span>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="Enter your email"
              autocomplete="email"
              required
            />
          </div>
        </div>

        <!-- Password -->
        <div class="form-group">
          <div class="password-label">
            <label for="password">Password</label>

            <a href="/forgot-password"> Forgot password? </a>
          </div>

          <div class="input-box">
            <span class="input-icon">🔒</span>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            />

            <button
              type="button"
              class="show-password"
              id="togglePassword"
              aria-label="Show password"
            >
              👁
            </button>
          </div>
        </div>

        <!-- Remember -->
        <div class="form-options">
          <label class="remember">
            <input type="checkbox" name="remember" />
            <span>Remember me</span>
          </label>
        </div>

        <!-- Login Button -->
        <button type="submit" class="login-btn">
          <span>Sign In</span>
          <span class="arrow">→</span>
        </button>
      </form>

      <div class="divider">
        <span>OR</span>
      </div>

      <!-- Social Login -->
      <div class="social-login">
        <!-- <button type="button" class="social-btn">
          <span>G</span>
          Continue with Google
        </button> -->
        <p>user - apex5759@gmail.com</p>
        <p>password - 123456</p>
      </div>

      <!-- Register -->
      <p class="register-text">
        Don't have an account?
        <a href="/register">Create an account</a>
      </p>
    </div>
  </section>
</main>
<script>
  const password = document.getElementById("password");
  const togglePassword = document.getElementById("togglePassword");

  togglePassword.addEventListener("click", () => {
    if (password.type === "password") {
      password.type = "text";
      togglePassword.textContent = "🙈";
    } else {
      password.type = "password";
      togglePassword.textContent = "👁";
    }
  });
</script>
</body>
</html>
